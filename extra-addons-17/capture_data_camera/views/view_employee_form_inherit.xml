<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_employee_form_get_data_btn" model="ir.ui.view">
        <field name="name">view_employee_form_get_data_btn</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="get_employee_data" string="Obtener Información" type="object" class="oe_highlight" onclick="uploadEmployeeImage(this); return false;"/>
            </xpath>
        </field>
    </record>
</odoo>
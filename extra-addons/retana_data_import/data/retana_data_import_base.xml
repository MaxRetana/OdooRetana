<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Unidad de medida personalizada usada en lineas de presupuesto -->
        <record id="uom_ml" model="uom.uom">
            <field name="name">ml</field>
            <field name="relative_factor">1</field>
        </record>

        <!-- Impuesto de venta 16% usado en los presupuestos -->
        <record id="tax_group_retana" model="account.tax.group">
            <field name="name">Presupuestos Retana</field>
            <field name="country_id" ref="base.mx"/>
        </record>
        <record id="tax_iva_16" model="account.tax">
            <field name="name">16%</field>
            <field name="amount_type">percent</field>
            <field name="amount">16</field>
            <field name="type_tax_use">sale</field>
            <field name="tax_group_id" ref="tax_group_retana"/>
            <field name="country_id" ref="base.mx"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View expense.tracking.category View Tree -->
    <record id="view_expense_tracking_category_tree" model="ir.ui.view">
        <field name="name">view.expense.tracking.category.tree</field>
        <field name="model">expense.tracking.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="color"/>
                <field name="active" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- View expense.tracking.category form -->
    <record id="view_expense_tracking_category_form" model="ir.ui.view">
        <field name="name">view.expense.tracking.category.form</field>
        <field name="model">expense.tracking.category</field>
        <field name="arch" type="xml">
            <form string="Expense Tracking Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group name="group_category_details" string="Detalles">
                        <field name="description"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View expense.tracking.category search -->
    <record id="view_expense_tracking_category_search" model="ir.ui.view">
        <field name="name">view.expense.tracking.category.search</field>
        <field name="model">expense.tracking.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nombre"/>
                <group expand="1" string="Group By">
                    <!-- Filtro creado el -->
                    <filter name="created_date" string="Creado el" domain="[]" context="{'group_by':'create_date'}"/>
                    <!-- Filtro creado por -->
                    <filter name="created_by" string="Creado por" domain="[]" context="{'group_by':'create_uid'}"/>
                </group>
                <!-- Filtro Activos -->
                <filter name="active" string="Activos" domain="[('active', '=', True)]"/>
                <!-- Filtro Inactivos -->
                <filter name="inactive" string="Archivados" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action expense.tracking.category -->
    <record id="action_expense_tracking_category" model="ir.actions.act_window">
        <field name="name">Categorias de Gastos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">expense.tracking.category</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay ejemplos, haga clic aquí para agregar una nueva Categoría de Gastos.
            </p>
        </field>
    </record>

</odoo>

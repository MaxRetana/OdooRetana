<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla del reporte de presupuesto -->
    <template id="report_retana_budget_document">
        <t t-call="web.html_container" data-report-header="0">
            <t t-foreach="docs" t-as="o">
                <t t-set="company_info" t-value="o.env['retana.company.info'].get_company_info()"/>
                <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                    <div class="page" style="font-family: Arial, Helvetica, sans-serif; font-size: 10pt; padding: 0px 50px !important; border: none !important;">
                        
                        <!-- Encabezado centrado -->
                        <div style="text-align: center; margin-bottom: 5px;">
                            <div style="font-size: 13pt; font-weight: bold; margin-bottom: 3px;">
                                <t t-esc="company_info.company_name"/>
                            </div>
                            <div style="font-size: 12pt; font-weight: bold; margin-bottom: 8px;">
                                <t t-esc="company_info.business_line"/>
                            </div>
                        </div>

                        <!-- Información de contacto en dos columnas -->
                        <table style="width: 100%; font-size: 8pt; margin-bottom: 8px; border-collapse: collapse;">
                            <tr>
                                <td style="text-align: left; width: 50%; font-weight: bold; line-height: 1.3;">
                                    R.F.C. <t t-esc="company_info.rfc"/><br/>
                                    <t t-esc="company_info.address"/><br/>
                                    TEL <t t-esc="company_info.phone"/> CEL. <t t-esc="company_info.mobile"/>
                                </td>
                                <td style="text-align: right; width: 50%; font-weight: bold; line-height: 1.3;">
                                    C.U.R.P. <t t-esc="company_info.curp"/><br/>
                                    <t t-esc="company_info.zone"/><br/>
                                    C.P. <t t-esc="company_info.postal_code"/> <t t-esc="company_info.city"/>, <t t-esc="company_info.state"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Línea separadora -->
                        <hr style="border: none; border-top: 2px solid black; margin: 10px 0;"/>

                        <!-- Fecha -->
                        <div style="text-align: right; font-weight: bold; font-size: 10pt; margin: 15px 0;">
                            <t t-set="months" t-value="{'01': 'ENERO', '02': 'FEBRERO', '03': 'MARZO', '04': 'ABRIL', '05': 'MAYO', '06': 'JUNIO', '07': 'JULIO', '08': 'AGOSTO', '09': 'SEPTIEMBRE', '10': 'OCTUBRE', '11': 'NOVIEMBRE', '12': 'DICIEMBRE'}"/>
                            COLIMA, COL; <t t-esc="o.date.strftime('%d').lstrip('0')"/> DE <t t-esc="months.get(o.date.strftime('%m'), 'DICIEMBRE')"/> DEL AÑO <t t-esc="o.date.strftime('%Y')"/>
                        </div>


                        <!-- Titulo del presuspuesto -->
                        <t t-if="o.title">
                            <div style="font-weight: bold; font-size: 10pt; margin: 15px 0; text-align: left;">
                                
                                <t t-esc="o.title.upper()"/>
                                
                            </div>
                        </t>

                        <!-- Descripción del presupuesto -->
                        <t t-if="o.description">
                            <div style="font-weight: bold; font-size: 10pt; margin: 15px 0; text-align: left;">
                                
                                <t t-esc="o.description.upper()"/>
                                
                            </div>
                        </t>

                        <!-- Tabla de conceptos -->
                        <t t-set="show_amount_columns" t-value="not o.budget_type_id.is_material_list and any(l.display_type not in ('line_section', 'line_note') and not (l.quantity == 0 and l.unit_price == 0 and l.subtotal == 0) for l in o.line_ids)"/>
                        <table style="width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 10pt;">
                            <thead>
                                <t t-if="o.budget_type_id.is_material_list">
                                    <!-- Encabezados para lista de materiales (sin precios) -->
                                    <tr>
                                        <th style="text-align: left; padding: 6px 4px; font-weight: bold; width: 75%;">CONCEPTO</th>
                                        <th style="text-align: center; padding: 6px 4px; font-weight: bold; width: 25%;">PZA.</th>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <!-- Encabezados normales (con precios) -->
                                    <t t-if="show_amount_columns">
                                        <tr>
                                            <th style="text-align: left; padding: 6px 4px; font-weight: bold; width: 50%;"></th>
                                            <th style="text-align: center; padding: 6px 4px; font-weight: bold; width: 10%;">PZA.</th>
                                            <th style="text-align: right; padding: 6px 4px; font-weight: bold; width: 20%;">PRECIO</th>
                                            <th style="text-align: right; padding: 6px 4px; font-weight: bold; width: 20%;">TOTAL</th>
                                        </tr>
                                    </t>
                                </t>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-if="line.display_type == 'line_section'">
                                        <!-- Línea de sección -->
                                        <tr>
                                            <td colspan="4" style="padding: 15px 4px 8px 4px; text-align: center; font-weight: bold; font-size: 11pt;">
                                                <t t-esc="(line.description or '').upper()"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <!-- Línea de nota -->
                                        <tr>
                                            <td colspan="4" style="padding: 8px 4px; text-align: left; font-style: italic;">
                                                <t t-esc="line.description or ''"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <!-- Línea normal de producto -->
                                        <t t-if="o.budget_type_id.is_material_list">
                                            <!-- Formato para lista de materiales (sin precios) -->
                                            <tr>
                                                <td style="padding: 4px; vertical-align: top; text-align: left;">
                                                    <t t-if="line.description and line.product_id and line.description != line.product_id.name">
                                                        <t t-esc="line.description.upper()"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="(line.product_id.name or '').upper()"/>
                                                    </t>
                                                </td>
                                                <td style="text-align: center; padding: 4px; vertical-align: top;">
                                                    <t t-esc="int(line.quantity)"/>
                                                    <t t-if="line.uom_id and (line.uom_id.name or '').strip().upper() != 'UNIDADES'">
                                                        <t t-esc="line.uom_id.name"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-else="">
                                            <!-- Formato normal (con precios) -->
                                            <tr>
                                                <t t-if="line.quantity == 0 and line.unit_price == 0 and line.subtotal == 0">
                                                    <td colspan="4" style="padding: 4px; vertical-align: top; text-align: left;">
                                                        <t t-if="line.description and line.product_id and line.description != line.product_id.name">
                                                            <t t-esc="line.description.upper()"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="(line.product_id.name or '').upper()"/>
                                                        </t>
                                                    </td>
                                                </t>
                                                <t t-else="">
                                                    <td style="padding: 4px; vertical-align: top; text-align: left;">
                                                        <t t-if="line.description and line.product_id and line.description != line.product_id.name">
                                                            <t t-esc="line.description.upper()"/>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-esc="(line.product_id.name or '').upper()"/>
                                                        </t>
                                                    </td>
                                                    <td style="text-align: center; padding: 4px; vertical-align: top;">
                                                        <t t-esc="int(line.quantity)"/>
                                                        <t t-if="line.uom_id and (line.uom_id.name or '').strip().upper() != 'UNIDADES'">
                                                            <t t-esc="line.uom_id.name"/>
                                                        </t>
                                                    </td>
                                                    <td style="text-align: right; padding: 4px; vertical-align: top;">
                                                        $<t t-esc="'{:,.2f}'.format(line.unit_price)"/>
                                                    </td>
                                                    <td style="text-align: right; padding: 4px; vertical-align: top;">
                                                        <t t-if="line_last">
                                                            <div style="display: inline-block; border-bottom: 2px solid black; padding-bottom: 2px;">
                                                                $<t t-esc="'{:,.2f}'.format(line.subtotal)"/>
                                                            </div>
                                                        </t>
                                                        <t t-else="">
                                                            $<t t-esc="'{:,.2f}'.format(line.subtotal)"/>
                                                        </t>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
                                <!-- No mostrar totales si es lista de materiales -->
                                <t t-if="not o.budget_type_id.is_material_list and show_amount_columns">
                                    <!-- Fila del subtotal (solo si hay IVA, descuento o anticipo) -->
                                    <tr t-if="o.tax_amount > 0 or o.discount_amount > 0 or o.downpayment_amount > 0">
                                        <td colspan="3" style="text-align: right; padding: 8px 4px; font-weight: bold;">
                                            SUBTOTAL
                                        </td>
                                        <td style="text-align: right; padding: 8px 4px; font-weight: bold;">
                                            $<t t-esc="'{:,.2f}'.format(o.subtotal_amount)"/>
                                        </td>
                                    </tr>
                                    <!-- Fila del IVA (solo si hay IVA) -->
                                    <tr t-if="o.tax_amount > 0">
                                        <td colspan="3" style="text-align: right; padding: 8px 4px;">
                                            IVA
                                        </td>
                                        <td style="text-align: right; padding: 8px 4px;">
                                            $<t t-esc="'{:,.2f}'.format(o.tax_amount)"/>
                                        </td>
                                    </tr>
                                    <!-- Fila del descuento (solo si hay descuento) -->
                                    <tr t-if="o.discount_amount > 0">
                                        <td colspan="3" style="text-align: right; padding: 8px 4px;">
                                            DESCUENTO (<t t-esc="'{:.0f}'.format(o.discount * 100)"/>%)
                                        </td>
                                        <td style="text-align: right; padding: 8px 4px;">
                                            -$<t t-esc="'{:,.2f}'.format(o.discount_amount)"/>
                                        </td>
                                    </tr>
                                    <!-- Fila del anticipo (solo si hay anticipo) -->
                                    <tr t-if="o.downpayment_amount > 0">
                                        <td colspan="3" style="text-align: right; padding: 8px 4px;">
                                            ANTICIPO
                                        </td>
                                        <td style="text-align: right; padding: 8px 4px;">
                                            -$<t t-esc="'{:,.2f}'.format(o.downpayment_amount)"/>
                                        </td>
                                    </tr>
                                    <!-- Fila del total -->
                                    <tr>
                                        <td colspan="3" style="text-align: right; padding: 8px 4px; font-weight: bold;">
                                            TOTAL
                                        </td>
                                        <td style="text-align: right; padding: 8px 4px; font-weight: bold;">
                                            $<t t-esc="'{:,.2f}'.format(o.total_amount)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Sección de atentamente -->
                        <t t-if="o.show_sign">
                            <div style="margin-top: 80px; text-align: center;">
                                <div style="font-weight: bold; font-size: 11pt; letter-spacing: 8px; margin-bottom: 50px;">
                                    A T E N T A M E N T E
                                </div>
                                
                                <div style="font-weight: bold; font-size: 10pt; margin-bottom: 60px;">
                                    <t t-if="o.total_amount and not o.budget_type_id.is_material_list">
                                        <t t-esc="o.currency_id.amount_to_text(o.total_amount).upper()"/> M.N
                                    </t>
                                </div>

                                <div style="margin: 0 auto; width: 350px;">
                                    <div style="border-top: 1.5px solid black; padding-top: 8px; font-weight: bold; font-size: 10pt;">
                                        <t t-esc="company_info.company_name"/>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Acción del reporte -->
    <record id="action_report_retana_budget" model="ir.actions.report">
        <field name="name">Presupuesto Retana</field>
        <field name="model">retana.budget</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">retana_bills.report_retana_budget_document</field>
        <field name="report_file">retana_bills.report_retana_budget_document</field>
        <field name="binding_model_id" ref="model_retana_budget"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">
            '%s %s %s %s' % (
                object.budget_type_id.name.upper() if object.budget_type_id else '',
                ('PARA EL ' + object.client_id.retana_type_res_partner_id.code.upper() if object.client_id.retana_type_res_partner_id else '') if object.client_id else '',
                object.client_id.name.upper() if object.client_id else '',
                ('EN LA OBRA ' + object.building_id.name.upper()) if object.building_id else ''
            )
        </field>
    </record>
</odoo>

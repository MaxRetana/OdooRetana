<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_retana_budget" model="ir.sequence">
        <field name="name">Retana Budget Sequence</field>
        <field name="code">retana.budget</field>
        <field name="prefix">RB</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_retana_downpayment" model="ir.sequence">
        <field name="name">Retana Downpayment Sequence</field>
        <field name="code">retana.downpayment</field>
        <field name="prefix">RD</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>

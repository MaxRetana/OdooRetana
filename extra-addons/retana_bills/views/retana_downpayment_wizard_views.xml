<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de formulario del wizard de anticipos -->
        <record id="view_retana_downpayment_wizard_form" model="ir.ui.view">
            <field name="name">retana.downpayment.wizard.form</field>
            <field name="model">retana.downpayment.wizard</field>
            <field name="arch" type="xml">
                <form string="Crear Anticipo">
                    <sheet>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="currency_id" invisible="1" readonly="1" force_save="1"/>
                                <field name="amount" widget="retana_bills.amount_selector"/>
                                <field name="building_id" options="{'no_create': True, 'no_open': True}" readonly="1" force_save="1"/>
                                <field name="client_id" options="{'no_create': True, 'no_open': True}" readonly="1" force_save="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Crear Anticipo" name="action_create_downpayment" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

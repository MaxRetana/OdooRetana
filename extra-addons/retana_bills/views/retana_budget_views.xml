<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree de Presupuestos -->
    <record id="view_retana_budget_tree" model="ir.ui.view">
        <field name="name">retana.budget.list</field>
        <field name="model">retana.budget</field>
        <field name="arch" type="xml">
            <list string="Presupuestos">
                <field name="name"/>
                <field name="client_id"/>
                <field name="building_id" optional="show"/>
                <field name="budget_type_id" optional="hide"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'sent'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="total_amount" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- Vista Form de Presupuestos -->
    <record id="view_retana_budget_form" model="ir.ui.view">
        <field name="name">retana.budget.form</field>
        <field name="model">retana.budget</field>
        <field name="arch" type="xml">
            <form string="Presupuesto">
                <header>
                    <button name="action_send" string="Marcar como enviado" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'sent')"/>
                    <button name="action_reject" string="Rechazar" type="object"
                            invisible="state not in ('draft', 'sent')"/>
                    <button name="action_draft" string="Volver a borrador" type="object"
                            invisible="state != 'rejected'"/>
                    <button name="action_draft" string="Reabrir" type="object"
                            invisible="state != 'approved'" groups="retana_bills.group_retana_admin"/>
                    <widget name="retana_chatter_position_toggle"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group name="header_info" string="Información del Presupuesto">
                        <field name="title" readonly="state == 'approved'"/>
                        <field name="description" readonly="state == 'approved'"/>
                    </group>
                    <group>
                        <group name="general_info" string="Información General">
                            <field name="budget_type_id" required="1" readonly="state == 'approved'"/>
                            <field name="is_material_list" invisible="1"/>
                            <field name="client_id" required="1" readonly="state == 'approved'"/>
                            <field name="building_id" required="1" readonly="state == 'approved'"/>
                        </group>
                        <group name="aditional_info" string="Información Adicional">
                            <field name="date" required="1" readonly="state == 'approved'"/>
                            <field name="downpayment_amount" widget="monetary" readonly="state == 'approved'"/>
                            <field name="discount" widget="percentage" readonly="state == 'approved'"/>
                            <field name="taxes_ids" widget="many2many_tags" readonly="state == 'approved'"/>
                            <field name="currency_id" required="1" readonly="state == 'approved'"/>
                            <field name="show_sign" readonly="state == 'approved'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conceptos">
                            <field name="line_ids" readonly="state == 'approved'">
                                <list editable="bottom" decoration-bf="display_type == 'line_section'" decoration-it="display_type == 'line_note'">
                                    <control>
                                        <create name="add_product_control" string="Agregar concepto"/>
                                        <create name="add_section_control" string="Agregar sección" context="{'default_display_type': 'line_section'}"/>
                                        <create name="add_note_control" string="Agregar nota" context="{'default_display_type': 'line_note'}"/>
                                    </control>
                                    <field name="sequence" widget="handle"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="display_type" optional="1" column_invisible="parent.is_material_list"/>
                                    <field name="product_id" required="display_type in (False, None)" force_save="1"/>
                                    <field name="description" widget="section_and_note_text"/>
                                    <field name="quantity" required="display_type in (False, None)" force_save="1"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price" widget="monetary" required="display_type in (False, None)" force_save="1" column_invisible="parent.is_material_list"/>
                                    <field name="taxes_ids" widget="many2many_tags" force_save="1" column_invisible="parent.is_material_list"/>
                                    <field name="subtotal" widget="monetary" force_save="1" column_invisible="parent.is_material_list"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="subtotal_amount" widget="monetary" readonly="1"/>
                        <field name="tax_amount" widget="monetary" readonly="1" invisible="tax_amount == 0"/>
                        <field name="discount_amount" widget="monetary" readonly="1" invisible="discount_amount == 0"/>
                        <field name="downpayment_amount" widget="monetary" readonly="1" invisible="downpayment_amount == 0"/>
                        <field name="total_amount" widget="monetary" class="oe_subtotal_footer_separator" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda de Presupuestos -->
    <record id="view_retana_budget_search" model="ir.ui.view">
        <field name="name">retana.budget.search</field>
        <field name="model">retana.budget</field>
        <field name="arch" type="xml">
            <search string="Presupuestos">
                <field name="name"/>
                <field name="title"/>
                <field name="client_id"/>
                <field name="building_id"/>
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Enviado" domain="[('state', '=', 'sent')]"/>
                <filter name="filter_approved" string="Aprobado" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rechazado" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_this_month" string="Mes actual"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <group>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_client" string="Cliente" context="{'group_by': 'client_id'}"/>
                    <filter name="group_building" string="Obra" context="{'group_by': 'building_id'}"/>
                    <filter name="group_date" string="Mes" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_retana_budget" model="ir.actions.act_window">
        <field name="name">Presupuestos</field>
        <field name="res_model">retana.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo presupuesto
            </p>
            <p>
                Administra los presupuestos de tus clientes.
            </p>
        </field>
    </record>
</odoo>

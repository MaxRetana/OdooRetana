<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View retana.downpayment.type.concept View Tree -->
    <record id="view_retana_downpayment_type_concept_tree" model="ir.ui.view">
        <field name="name">view_retana_downpayment_type_concept_list</field>
        <field name="model">retana.downpayment.type.concept</field>
        <field name="arch" type="xml">
            <list string="Tipos de Conceptos de Anticipo Retana">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View retana.downpayment.type.concept form -->
    <record id="view_retana_downpayment_type_concept_form" model="ir.ui.view">
        <field name="name">view_retana_downpayment_type_concept_form</field>
        <field name="model">retana.downpayment.type.concept</field>
        <field name="arch" type="xml">
            <form string="Tipo de Concepto de Anticipo Retana">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="default_concept"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View retana.downpayment.type.concept search -->
    <record id="view_retana_downpayment_type_concept_search" model="ir.ui.view">
        <field name="name">view_retana_downpayment_type_concept_search</field>
        <field name="model">retana.downpayment.type.concept</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action retana.downpayment.type.concept -->
    <record id="action_retana_downpayment_type_concept" model="ir.actions.act_window">
        <field name="name">Tipo de Concepto de Anticipo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">retana.downpayment.type.concept</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Crear un nuevo Tipo de Concepto de Anticipo Retana
            </p>
        </field>
    </record>
</odoo>

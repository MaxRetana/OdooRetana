<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal de Electricos Retana -->
    <menuitem id="menu_retana_bills_root"
              name="Electricos Retana"
              web_icon="retana_bills,static/description/icon.png"
              sequence="10"/>

    <!-- Submenú de Presupuestos -->
    <menuitem id="menu_retana_budgets"
              name="Presupuestos"
              parent="menu_retana_bills_root"
              action="action_retana_budget"
              sequence="10"/>
    
    <!-- Menú de Configuración -->
    <menuitem id="menu_retana_bills_config"
              name="Configuración"
              parent="menu_retana_bills_root"
              sequence="100"/>
    
    <!-- Submenú de Líneas de Presupuesto -->
    <menuitem id="menu_retana_budget_lines"
              name="Líneas de Presupuesto"
              parent="menu_retana_bills_config"
              action="action_retana_budget_line"
              sequence="20"/>

    <!-- Acción para Productos -->
    <record id="action_retana_products" model="ir.actions.act_window">
        <field name="name">Productos</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer producto
            </p>
        </field>
    </record>

    <!-- Submenú de Productos -->
    <menuitem id="menu_retana_products"
              name="Productos"
              parent="menu_retana_bills_config"
              action="action_retana_products"
              sequence="30"/>

    <!-- Acción para Clientes -->
    <record id="action_retana_customers" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_retana_customer', '=', True)]</field>
        <field name="context">{'default_is_retana_customer': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer cliente
            </p>
        </field>
    </record>

    <!-- Submenú de Clientes -->
    <menuitem id="menu_retana_customers"
              name="Clientes"
              parent="menu_retana_bills_config"
              action="action_retana_customers"
              sequence="40"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View retana.type.res.partner View Tree -->
    <record id="view_retana_type_res_partner_tree" model="ir.ui.view">
        <field name="name">view_retana_type_res_partner_tree</field>
        <field name="model">retana.type.res.partner</field>
        <field name="arch" type="xml">
            <tree string="Tipos de Clientes Retana">
                <field name="name"/>
                <field name="code" />
                <field name="description" optional="1"/>
                <field name="active" optional="1"/>
            </tree>
        </field>
    </record>

    <!-- View retana.type.res.partner form -->
    <record id="view_retana_type_res_partner_form" model="ir.ui.view">
        <field name="name">view_retana_type_res_partner_form</field>
        <field name="model">retana.type.res.partner</field>
        <field name="arch" type="xml">
            <form string="Tipo de Cliente Retana">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="code" />
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View retana.type.res.partner search -->
    <record id="view_retana_type_res_partner_search" model="ir.ui.view">
        <field name="name">view_retana_type_res_partner_search</field>
        <field name="model">retana.type.res.partner</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action retana.type.res.partner -->
    <record id="action_retana_type_res_partner" model="ir.actions.act_window">
        <field name="name">Tipo de Cliente Retana</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">retana.type.res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Crea tu primer tipo de cliente Retana
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View retana.sent.wh View Tree -->
    <record id="view_retana_sent_wh_tree" model="ir.ui.view">
        <field name="name">view_retana_sent_wh_tree</field>
        <field name="model">retana.sent.wh</field>
        <field name="arch" type="xml">
            <tree string="Agenda WhatsApp">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="report_type"/>
                <field name="sent_count"/>
                <field name="last_sent_date"/>
            </tree>
        </field>
    </record>

    <!-- View retana.sent.wh form -->
    <record id="view_retana_sent_wh_form" model="ir.ui.view">
        <field name="name">view_retana_sent_wh_form</field>
        <field name="model">retana.sent.wh</field>
        <field name="arch" type="xml">
            <form string="Agenda WhatsApp">
                <header>
                    <button name="action_send_whatsapp" string="Enviar por WhatsApp" type="object" class="btn-primary"/>
                    <button name="action_open_wizard" string="Enviar con Wizard" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_send_whatsapp" icon="fa-whatsapp">
                            <field name="sent_count" widget="statinfo" string="Enviado"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre del contacto..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone_number" placeholder="+52 123 456 7890"/>
                            <field name="report_type"/>
                        </group>
                        <group>
                            <field name="last_sent_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" widget="text" placeholder="Mensaje predeterminado al enviar..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View retana.sent.wh search -->
    <record id="view_retana_sent_wh_search" model="ir.ui.view">
        <field name="name">view_retana_sent_wh_search</field>
        <field name="model">retana.sent.wh</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action retana.sent.wh -->
    <record id="action_retana_sent_wh" model="ir.actions.act_window">
        <field name="name">Agenda WhatsApp</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">retana.sent.wh</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Crea tu primera entrada en la agenda de WhatsApp
            </p>
        </field>
    </record>
        <!-- Menu Agenda de Whatsapp -->
    <menuitem id="menu_retana_sent_wh"
              name="Agenda de WhatsApp"
              parent="retana_bills.menu_retana_bills_config"
              action="action_retana_sent_wh"
              sequence="70"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View retana.downpayment View Tree -->
    <record id="view_retana_downpayment_tree" model="ir.ui.view">
        <field name="name">view_retana_downpayment_tree</field>
        <field name="model">retana.downpayment</field>
        <field name="arch" type="xml">
            <tree string="Anticipos Retana">
                <field name="name"/>
                <field name="concept_id"/>
                <field name="amount" widget="monetary"/>
                <field name="currency_id"/>
                <field name="date"/>
                <field name="building_id"/>
                <field name="client_id"/>
            </tree>
        </field>
    </record>

    <!-- View retana.downpayment form -->
    <record id="view_retana_downpayment_form" model="ir.ui.view">
        <field name="name">view_retana_downpayment_form</field>
        <field name="model">retana.downpayment</field>
        <field name="arch" type="xml">
            <form string="Anticipo Retana">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..." readonly="1" force_save="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="concept_id"/>
                        <field name="amount" widget="monetary"/>
                        <field name="currency_id"/>
                        <field name="date"/>
                        <field name="building_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="client_id" options="{'no_create': True, 'no_edit': True}" required="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- View retana.downpayment search -->
    <record id="view_retana_downpayment_search" model="ir.ui.view">
        <field name="name">view_retana_downpayment_search</field>
        <field name="model">retana.downpayment</field>
        <field name="arch" type="xml">
            <search>
                <field name="building_id" />
                <field name="client_id" />
                <field name="concept_id" />
                <field name="date" />
                <filter string="Semana Actual" name="current_week" domain="[('date', '&gt;=', (context_today() + relativedelta(weeks=-1, weekday=0)).strftime('%Y-%m-%d')), ('date', '&lt;=', (context_today() + relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                    <filter string="Cliente" name="client_group" domain="[]" context="{'group_by':'client_id'}"/>
                    <filter string="Concepto" name="concept_group" domain="[]" context="{'group_by':'concept_id'}"/>
                    <filter string="Obra" name="building_group" domain="[]" context="{'group_by':'building_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action retana.downpayment -->
    <record id="action_retana_downpayment" model="ir.actions.act_window">
        <field name="name">Anticipos Retana</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">retana.downpayment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_current_week': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Crear un nuevo anticipo de Retana
            </p>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista de árbol personalizada para proveedores Retana -->
    <record id="view_retana_res_partner_tree" model="ir.ui.view">
        <field name="name">view.retana.res.partner.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Proveedores Retana">
                <field name="name"/>
                <field name="retana_type_res_partner_id"/>
                <field name="is_retana_customer" optional="1"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario simplificada para proveedores Retana -->
    <record id="view_retana_res_partner_form" model="ir.ui.view">
        <field name="name">view.retana.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form string="Proveedor Retana">
                <sheet>
                    <group>
                        <field name="name" placeholder="Nombre del Proveedor"/>
                        <field name="is_retana_customer"/>
                        <field name="retana_type_res_partner_id" options="{'no_create': True, 'no_edit': True}"/>
                    </group>
                </sheet>
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Acción de ventana para los proveedores Retana -->
    <record id="action_retana_res_partner" model="ir.actions.act_window">
        <field name="name">Proveedores Retana</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_retana_customer', '=', True)]</field>
        <field name="context">{'default_is_retana_customer': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_retana_res_partner_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_retana_res_partner_form')})]"/>
    </record>

    <!-- Menú para acceder a los proveedores Retana -->
    <!-- <menuitem id="menu_retana_res_partner"
              name="Proveedores"
              parent="retana_bills.menu_retana_bills_root"
              action="action_retana_res_partner"
              sequence="10"/> -->

</odoo>
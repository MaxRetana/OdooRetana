<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista Tree para Tipo de Presupuesto -->
    <record id="view_retana_budget_type_tree" model="ir.ui.view">
        <field name="name">retana.budget.type.tree</field>
        <field name="model">retana.budget.type</field>
        <field name="arch" type="xml">
            <tree string="Tipos de Presupuesto">
                <field name="name"/>
                <field name="is_material_list"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form para Tipo de Presupuesto -->
    <record id="view_retana_budget_type_form" model="ir.ui.view">
        <field name="name">retana.budget.type.form</field>
        <field name="model">retana.budget.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de Presupuesto">
                <sheet>
                    <group>
                        <field name="name" placeholder="Ej: Residencial, Comercial, Industrial..."/>
                        <field name="is_material_list" widget="boolean_button" options='{"terminology": "checkbox"}'/>
                        <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Search para Tipo de Presupuesto -->
    <record id="view_retana_budget_type_search" model="ir.ui.view">
        <field name="name">retana.budget.type.search</field>
        <field name="model">retana.budget.type</field>
        <field name="arch" type="xml">
            <search string="Buscar Tipos de Presupuesto">
                <field name="name" string="Tipo" filter_domain="[('name','ilike',self)]"/>
                <filter string="Activos" name="active" domain="[('active','=',True)]"/>
                <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Estado" name="group_by_active" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_retana_budget_type" model="ir.actions.act_window">
        <field name="name">Tipos de Presupuesto</field>
        <field name="res_model">retana.budget.type</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo tipo de presupuesto
            </p>
            <p>
                Los tipos de presupuesto permiten clasificar y organizar los presupuestos según su naturaleza (Residencial, Comercial, Industrial, etc.).
            </p>
        </field>
    </record>
</odoo>

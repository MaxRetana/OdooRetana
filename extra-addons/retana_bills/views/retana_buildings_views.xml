<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree de Obras -->
    <record id="view_retana_buildings_tree" model="ir.ui.view">
        <field name="name">retana.buildings.tree</field>
        <field name="model">retana.buildings</field>
        <field name="arch" type="xml">
            <tree string="Obras">
                <field name="name"/>
                <field name="client_id"/>
                <field name="active"/>
                <!-- Boton para crear anticipo -->
                <button name="action_create_downpayment" type="object" string="Crear Anticipo" class="oe_highlight"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form de Obras -->
    <record id="view_retana_buildings_form" model="ir.ui.view">
        <field name="name">retana.buildings.form</field>
        <field name="model">retana.buildings</field>
        <field name="arch" type="xml">
            <form string="Obra">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la Obra"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="active" widget="boolean_button"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Search de Obras -->
    <record id="view_retana_buildings_search" model="ir.ui.view">
        <field name="name">retana.buildings.search</field>
        <field name="model">retana.buildings</field>
        <field name="arch" type="xml">
            <search string="Buscar Obras">
                <field name="name" string="Nombre"/>
                <field name="client_id" string="Cliente"/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Cliente" name="group_by_client" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana para Obras -->
    <record id="action_retana_buildings" model="ir.actions.act_window">
        <field name="name">Obras</field>
        <field name="res_model">retana.buildings</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva Obra
            </p>
            <p>
                Gestiona las obras de Eléctricos Retana
            </p>
        </field>
    </record>

    <!-- Ítem de menú para Obras -->
    <menuitem id="menu_retana_buildings"
              name="Obras"
              parent="retana_bills.menu_retana_bills_root"
              action="action_retana_buildings"
              sequence="15"/>
</odoo>
